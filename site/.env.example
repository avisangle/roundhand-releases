# Where Windows waitlist signups are POSTed as JSON: {"email","platform","signedUpAt"}.
# Required in production; in development signups are logged to the console instead.
WAITLIST_WEBHOOK_URL=
# Optional. Sent as "Authorization: Bearer <secret>" so the receiver can reject strangers.
WAITLIST_WEBHOOK_SECRET=
# Canonical URL used for Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://roundhand.vercel.app
